# Claude API anahtarı: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# İsteğe bağlı. Varsayılan en ucuz model olan claude-haiku-4-5'tir.
# Daha isabetli ama daha pahalı değerlendirme için: claude-sonnet-5-5 veya claude-opus-5-5
# CLAUDE_MODEL=claude-haiku-4-5

# İsteğe bağlı. Yalnızca Sonnet/Opus modellerinde geçerlidir: low | medium | high
# CLAUDE_EFFORT=low

# İsteğe bağlı. Gönderilen sayfaların uzun kenarı (piksel). Düşürmek maliyeti azaltır,
# küçük el yazısının okunmasını zorlaştırır.
# SINAVMATIK_MAKS_KENAR=1568

# İsteğe bağlı. Veritabanı dosyasının yolu.
# SINAVMATIK_DB=sinavmatik.db
